{
  "name": "personal-budget-tracker",
  "version": "1.12.0",
  "description": "Savings-first personal budget tracker with live Safe-to-Spend calculations, variable pay isolation, and fast 3-tap expense logging.",
  "private": true,
  "author": "Parth Rana",
  "license": "MIT",
  "keywords": [
    "budget",
    "personal-finance",
    "savings-first",
    "nextjs",
    "supabase",
    "playwright",
    "typescript",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=client",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit --workspace=client",
    "test:e2e": "npm run test:e2e --workspace=client",
    "test:db": "supabase test db --workdir server",
    "lint": "npm run lint --workspace=client",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "supabase": "^3.3.0"
  }
}
