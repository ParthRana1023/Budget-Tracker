{
  "name": "personal-budget-tracker",
  "version": "0.3.0",
  "description": "Savings-first personal budget tracker with live Safe-to-Spend calculations, variable pay isolation, and fast 3-tap expense logging.",
  "private": true,
  "author": "Parth Rana",
  "license": "MIT",
  "keywords": [
    "budget",
    "personal-finance",
    "savings-first",
    "nextjs",
    "supabase",
    "playwright",
    "typescript",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"emerald,blue\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start:client": "npm run start --workspace=client",
    "start:server": "npm run start --workspace=server",
    "test": "npm run test:e2e",
    "test:e2e": "npm run test:e2e --workspace=client",
    "lint": "npm run lint --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
