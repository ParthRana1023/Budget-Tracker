# Production defaults (`npm run build` / `npm run start`). Non-secret switches only.
#
# The Supabase URL, publishable key and SUPABASE_SECRET_KEY are NOT set here: add them in
# Vercel > Project > Settings > Environment Variables (they override this file), or in
# .env.production.local for a local production build. Full list of variables: .env.example.

NEXT_PUBLIC_GOOGLE_AUTH=1
NEXT_PUBLIC_EMAIL_NOTIFICATIONS=0
