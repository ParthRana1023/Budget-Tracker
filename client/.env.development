# Local development defaults (`npm run dev`), pointing at the local Supabase stack
# (`npx supabase start --workdir server`, ports from server/supabase/config.toml).
# The publishable key is the Supabase CLI's standard local key: public, local-only, safe to commit.
# To develop against a hosted project instead, put its values in .env.local (it wins over this file).
# Full list of variables: .env.example.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Local secret key (`npx supabase status --workdir server` > SECRET_KEY) for sign-in history.
# Kept out of this committed file; put it in .env.local.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_GOOGLE_AUTH=0
NEXT_PUBLIC_EMAIL_NOTIFICATIONS=0
