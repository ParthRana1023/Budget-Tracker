# SaveFirst client (Next.js): every environment variable the app reads.
#
# How Next.js picks values (highest first): the shell / Vercel's Environment Variables,
# .env.<mode>.local, .env.local, .env.<mode>, .env. <mode> is "development" for `npm run dev`
# and "production" for `npm run build` / `npm run start`.
#
# Files in this folder:
#   .env.example      this list (committed)
#   .env.development  local defaults for `npm run dev`: the local Supabase stack (committed, no secrets)
#   .env.production   non-secret production defaults (committed)
#   .env.local        your own values, e.g. a hosted project (NOT committed; overrides the two above)
#
# Production on Vercel: set these under Project > Settings > Environment Variables.
# Never put a secret in a NEXT_PUBLIC_ variable: those are built into the browser bundle.

# ---- Supabase (required)
# Local stack: `npx supabase start --workdir server` prints API_URL and PUBLISHABLE_KEY.
# Hosted: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ---- Server only (no NEXT_PUBLIC_ prefix)
# The project's secret key (Supabase > Project Settings > API > Secret keys). Used only by
# server routes: the sign-in routes record sign-in history, and /api/rates caches exchange rates.
# Without it, sign-in works but isn't recorded, and rates are fetched again on every request.
SUPABASE_SECRET_KEY=

# ---- Feature switches ("1" = on)
# "Continue with Google" and Account > Linked accounts. Turn on only after enabling the Google
# provider (and manual linking) in Supabase > Authentication > Providers.
NEXT_PUBLIC_GOOGLE_AUTH=1
# Email notification settings. Turn on once the send-notifications job is deployed and scheduled.
NEXT_PUBLIC_EMAIL_NOTIFICATIONS=0

# ---- Web Push (optional)
# Generate the pair once with `npx web-push generate-vapid-keys`. Empty public key = the Push
# card in Settings is hidden. The same pair goes in server/supabase/functions/.env.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only: Settings › Notifications › Send a test (/api/push/test) signs with these.
# Never prefix them with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
