# Secrets for the send-notifications Edge Function (the hourly email job).
#
# Local:      copy to supabase/functions/.env (NOT committed); `npx supabase functions serve
#             --workdir server` loads it. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
#             provided automatically.
# Production: `npx supabase secrets set --env-file supabase/functions/.env --workdir server`,
#             or Supabase dashboard > Edge Functions > Secrets. Then run
#             supabase/cron/send-notifications.sql with the same CRON_SECRET.

# Resend API key (resend.com > API Keys).
RESEND_API_KEY=
# Sender, on a domain verified in Resend.
EMAIL_FROM=SaveFirst <hello@your-domain.com>
# Any long random string; the cron job sends it in the x-cron-secret header.
CRON_SECRET=
# The web app's address, used for links in the emails.
APP_URL=https://your-app.vercel.app
