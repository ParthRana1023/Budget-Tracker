# SaveFirst server (Express API in server/src): every environment variable it reads.
#
# Loaded by src/config/env.ts, highest first: the shell / host's environment, .env (your own,
# NOT committed), then .env.development or .env.production (committed defaults, chosen by
# NODE_ENV; anything other than "production" counts as development).
#
# The web app talks to Supabase directly and doesn't need this server. Email job secrets live
# in supabase/functions/.env.example.

# Port the API listens on.
PORT=5000

# The web app's origin, allowed by CORS.
CLIENT_URL=http://localhost:3000
